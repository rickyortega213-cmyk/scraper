class Style:
    enabled = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

    @classmethod
    def paint(cls, text: str, *codes: str) -> str:
        if not cls.enabled or not codes:
            return text
        return "".join(f"\033[{c}m" for c in codes) + text + "\033[0m"

    @classmethod
    def bold(cls, t: str) -> str: return cls.paint(t, "1")
    @classmethod
    def dim(cls, t: str) -> str: return cls.paint(t, "2")
    @classmethod
    def green(cls, t: str) -> str: return cls.paint(t, "32")
    @classmethod
    def red(cls, t: str) -> str: return cls.paint(t, "31")
    @classmethod
    def yellow(cls, t: str) -> str: return cls.paint(t, "33")
    @classmethod
    def cyan(cls, t: str) -> str: return cls.paint(t, "36")
    @classmethod
    def magenta(cls, t: str) -> str: return cls.paint(t, "35")


