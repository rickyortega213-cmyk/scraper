# ---------------------------------------------------------------------------
# gmscrape configuration. Copy to .env and fill in what you have.
# Every setting here can also be passed as a CLI flag (flags win).
# ---------------------------------------------------------------------------

# === 1. Google Maps scraping API ==========================================
# Set ONE of these. MAPS_PROVIDER=auto picks whichever key is present.
MAPS_PROVIDER=auto

# SCRAPERAPI_KEY=
# SERPAPI_KEY=
# SERPER_KEY=
# OUTSCRAPER_KEY=
# APIFY_TOKEN=
# APIFY_ACTOR=compass~crawler-google-places
# SCRAPINGDOG_KEY=

# Using an API that isn't listed? Describe it in JSON - no code needed.
# GENERIC_MAPS_CONFIG=examples/maps_api.example.json
# MAPS_API_KEY=your-key-here          # substituted as {api_key} in that file

# Already have a list of places? Skip the Maps call entirely:
# MAPS_PROVIDER=file
# PLACES_FILE=examples/places.example.csv

# === 2. Email verification API ============================================
VERIFY_PROVIDER=auto

# MAILTESTER_KEY=              # MailTester Ninja (the sub_... subscription id)
# MILLIONVERIFIER_KEY=
# ZEROBOUNCE_KEY=
# NEVERBOUNCE_KEY=
# REOON_KEY=
# EMAILLISTVERIFY_KEY=
# BOUNCER_KEY=

# Or describe your own verification API:
# GENERIC_VERIFY_CONFIG=examples/verify_api.example.json
# VERIFY_API_KEY=your-key-here

# With no key at all, verification falls back to local syntax + MX + junk
# checks, which can rule addresses out but never confirm a mailbox.

# === 3. Search ============================================================
RESULTS_PER_QUERY=40
MAPS_MAX_PAGES=5
LANGUAGE=en
COUNTRY=us

# === 4. Website crawling ==================================================
CRAWL_WEBSITES=true
MAX_PAGES_PER_SITE=6
HTTP_CONCURRENCY=12
PER_HOST_CONCURRENCY=2
HTTP_TIMEOUT=20
HTTP_RETRIES=2
OBEY_ROBOTS=true
ROTATE_USER_AGENT=true
CRAWL_DELAY=0

# === 5. Email permutations (used only when nothing was scraped) ===========
PERMUTATIONS=true
PERMUTATION_TIER=2              # 1=info/contact/hello  2=common  3=aggressive
PERMUTATION_MAX=12
PERMUTATION_REQUIRE_MX=true     # never guess on a domain that can't receive mail
PERMUTATIONS_FOR_CHAINS=false   # info@walmart.com is not a lead
STOP_ON_FIRST_VALID=true        # stop guessing once one verifies - saves credits

# === 6. Verification behaviour ============================================
VERIFY_EMAILS=true
VERIFY_FOUND=true
VERIFY_PERMUTATIONS=true
VERIFY_CONCURRENCY=4
VERIFY_BUDGET=0                 # max paid calls per run, 0 = unlimited
KEEP_RISKY=true
KEEP_INVALID=false

# === 7. Chains / big businesses ===========================================
CHAIN_MODE=flag                 # flag | skip | only
CHAIN_REVIEW_THRESHOLD=1500

# === 8. Supabase live lead table (optional) ===============================
# Mirrors every lead into Supabase while the run is going, so you can watch
# the table fill in. Apply the schema first:
#   gmscrape supabase-init --write supabase_schema.sql
#   ...paste it into the Supabase SQL editor...
#   gmscrape supabase-check
# Use the service_role key: it is server-side only and bypasses RLS.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_PREFIX=gmscrape_
SUPABASE=false

# === 9. Output ============================================================
OUT_DIR=out
DB_PATH=out/gmscrape.sqlite
EXPORT_FORMATS=csv,json
CACHE_HTTP=true
CACHE_TTL_HOURS=168
MIN_CONFIDENCE=0
LOG_LEVEL=INFO
